     "blockName": "Section · Prose",
     "children": [
      {
       "attributes": {},
       "baseStyles": {
        "color": "var(--55ee66ff-0002-4e02-8e02-eeff0002dd02, #171412)",
        "fontFamily": "Newsreader",
