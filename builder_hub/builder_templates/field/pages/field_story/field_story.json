       "blockId": "6e20169b95",
       "blockName": "Pull Quote",
       "children": [],
       "classes": [],
       "customAttributes": {},
       "element": "p",
       "innerHTML": "“You do not finish a walk like this.<br>You just stop somewhere flat.”",
       "mobileStyles": {
        "fontSize": "26px",
        "padding": "4px 0px 4px 20px"
       },
       "rawStyles": {},
       "tabletStyles": {}
      },
      {
       "attributes": {},
