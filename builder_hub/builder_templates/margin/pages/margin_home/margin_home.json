            "lineHeight": "1.85",
            "minWidth": "10px",
            "width": "fit-content"
           },
           "blockId": "25972b33ea",
           "blockName": "Excerpt Para 2",
           "children": [],
           "classes": [],
           "customAttributes": {},
           "element": "p",
           "innerHTML": "What the notebook is for, I have decided, is not memory but manners: it teaches you to notice. The entries that embarrass me most are the ones that matter<sup style=\"color: #3F6B4F; font-weight: 600;\">3</sup>, which is how I know the practice is working.",
           "mobileStyles": {},
           "rawStyles": {},
           "tabletStyles": {}
